            },
            "in": "query",
            "name": "page",
            "required": false,
            "description": "1-based page number"
          },
          {
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "in": "query",
            "name": "pageSize",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "on_leave",
                "inactive"
              ]
            },
            "in": "query",
            "name": "status",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "in": "query",
            "name": "depotId",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "valid",
                "expiring",
                "expired"
              ]
            },
            "in": "query",
            "name": "documents",
            "required": false,
            "description": "\"expiring\": the first document runs out within 30 days"
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 50
            },
            "in": "query",
            "name": "search",
            "required": false,
            "description": "Part of the name, phone or licence number"
          },
          {
            "schema": {
              "default": "lastName",
              "type": "string",
              "enum": [
                "lastName",
                "-lastName",
